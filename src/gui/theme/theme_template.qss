/* Central Application QSS Template */

/* Base widget defaults. Deliberately NO background-color here: a universal
   rule paints a rectangle behind every child widget, which forces every
   container to fight it with transparency. Window-level containers below
   own the backgrounds; pages opt in through QWidget[appBackground="..."]. */
QWidget {{
    color: {TEXT_PRIMARY};
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}}

/* Text defaults. Labels are transparent by default; semantic roles and tones
   are appended from Styles.get_typography_qss(). */
QLabel {{
    background: transparent;
    border: none;
}}

/* Page/container backgrounds are applied through a property so they do not
   cascade into child labels and paint rectangles behind text. */
QWidget[appBackground="background"] {{
    background-color: {BACKGROUND};
    border: none;
}}

QWidget[appBackground="surface"] {{
    background-color: {SURFACE};
    border: none;
}}

/* Transparent containers are marked with a property, never a
   declaration-only stylesheet: a bare setStyleSheet("background: ...")
   acts as a wildcard rule for every descendant and would override the
   application stylesheet for child buttons, inputs, and labels.
   "full" also strips the border; "background" keeps it. */
QWidget[transparent="full"] {{
    background: transparent;
    border: none;
}}

QWidget[transparent="background"] {{
    background: transparent;
}}

/* Main Window & Dialog Containers */
QMainWindow, QDialog {{
    background-color: {BACKGROUND};
}}

/* Card Containers */
QFrame#ReportCard, QFrame[card="true"] {{
    background-color: {SURFACE};
    border: 1px solid {BORDER};
    border-radius: 12px;
}}

QFrame#MetricCard, QFrame[metric_card="true"] {{
    background-color: {SURFACE};
    border: 1px solid {BORDER};
    border-radius: 12px;
}}

QFrame#MetricCard QWidget, QFrame[metric_card="true"] QWidget {{
    background-color: transparent;
}}

QFrame#GameCard {{
    background-color: {SURFACE_CARD};
    border: 1px solid {BORDER};
    border-radius: 8px;
}}

QFrame#GameCard:hover {{
    border-color: {ACCENT};
    background-color: {SURFACE};
}}

QFrame#GameCard QLabel {{
    background: transparent;
    border: none;
}}

QFrame#HeroCard, QFrame[hero="true"] {{
    background-color: transparent;
    border: none;
}}

/* Buttons */
QPushButton {{
    background-color: {SURFACE_LIGHT};
    color: {TEXT_PRIMARY};
    border: 1px solid {BORDER};
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
}}

QPushButton:hover {{
    background-color: {SURFACE};
    border-color: {ACCENT};
}}

QPushButton:pressed {{
    background-color: {HIGHLIGHT};
}}

/* Central Button matrix for src/gui/components/controls/button.py.
   The component publishes btnVariant / btnSize / btnDanger properties and
   the global template owns every palette-driven declaration. Instance
   specific tweaks (align, custom fonts/colours) stay on a tiny per-widget
   override sheet; custom-accent buttons fall back to Styles.get_button_qss.
   The bare QPushButton rules above remain the fallback for raw buttons. */

/* Sizes */
QPushButton[btnSize="xs"] {{
    padding: 1px 7px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
}}
QPushButton[btnSize="sm"] {{
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
}}
QPushButton[btnSize="md"] {{
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
}}
QPushButton[btnSize="lg"] {{
    padding: 10px 22px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
}}

/* Primary */
QPushButton[btnVariant="primary"] {{
    background-color: {ACCENT};
    color: {ON_ACCENT};
    border: 1px solid {ACCENT};
}}
QPushButton[btnVariant="primary"]:hover {{
    background-color: {ACCENT_HOVER};
    color: {ON_ACCENT};
    border: 1px solid {ACCENT_HOVER};
}}
QPushButton[btnVariant="primary"]:pressed {{
    background-color: {ACCENT};
    color: {ON_ACCENT};
    border: 1px solid {ACCENT};
}}
QPushButton[btnVariant="primary"]:checked {{
    background-color: {ACCENT_HOVER};
    color: {ON_ACCENT};
    border: 1px solid {ACCENT_HOVER};
}}
QPushButton[btnVariant="primary"]:disabled {{
    background-color: {BORDER};
    color: {TEXT_MUTED};
    border: 1px solid transparent;
}}

/* Filled */
QPushButton[btnVariant="filled"] {{
    background-color: {SURFACE_LIGHT};
    color: {TEXT_PRIMARY};
    border: 1px solid {BORDER};
}}
QPushButton[btnVariant="filled"]:hover {{
    background-color: {SURFACE};
    color: {TEXT_PRIMARY};
    border: 1px solid {ACCENT};
}}
QPushButton[btnVariant="filled"]:pressed {{
    background-color: {ACCENT_SUBTLE};
    color: {TEXT_PRIMARY};
    border: 1px solid {ACCENT};
}}
QPushButton[btnVariant="filled"]:checked {{
    background-color: {ACCENT_SUBTLE};
    color: {TEXT_PRIMARY};
    border: 1px solid {ACCENT};
}}
QPushButton[btnVariant="filled"]:disabled {{
    background-color: {SURFACE_LIGHT};
    color: {TEXT_MUTED};
    border: 1px solid {BORDER};
}}

/* Outlined */
QPushButton[btnVariant="outlined"] {{
    background-color: transparent;
    color: {ACCENT};
    border: 1px solid {ACCENT};
}}
QPushButton[btnVariant="outlined"]:hover,
QPushButton[btnVariant="outlined"]:pressed,
QPushButton[btnVariant="outlined"]:checked {{
    background-color: {ACCENT_SUBTLE};
    color: {ACCENT};
    border: 1px solid {ACCENT};
}}
QPushButton[btnVariant="outlined"]:disabled {{
    background-color: transparent;
    color: {TEXT_MUTED};
    border: 1px solid transparent;
}}

/* Tonal */
QPushButton[btnVariant="tonal"] {{
    background-color: {ACCENT_SUBTLE};
    color: {TEXT_PRIMARY};
    border: 1px solid {ACCENT_SUBTLE};
}}
QPushButton[btnVariant="tonal"]:hover {{
    background-color: {SURFACE_LIGHT};
    color: {TEXT_PRIMARY};
    border: 1px solid {ACCENT};
}}
QPushButton[btnVariant="tonal"]:pressed,
QPushButton[btnVariant="tonal"]:checked {{
    background-color: {ACCENT_SUBTLE};
    color: {TEXT_PRIMARY};
    border: 1px solid {ACCENT};
}}
QPushButton[btnVariant="tonal"]:disabled {{
    background-color: {SURFACE_LIGHT};
    color: {TEXT_MUTED};
    border: 1px solid transparent;
}}

/* Hollow */
QPushButton[btnVariant="hollow"] {{
    background-color: transparent;
    color: {TEXT_PRIMARY};
    border: 1px solid {BORDER};
}}
QPushButton[btnVariant="hollow"]:hover {{
    background-color: {SURFACE_LIGHT};
    color: {TEXT_PRIMARY};
    border: 1px solid {ACCENT};
}}
QPushButton[btnVariant="hollow"]:pressed,
QPushButton[btnVariant="hollow"]:checked {{
    background-color: {ACCENT_SUBTLE};
    color: {TEXT_PRIMARY};
    border: 1px solid {ACCENT};
}}
QPushButton[btnVariant="hollow"]:disabled {{
    background-color: transparent;
    color: {TEXT_MUTED};
    border: 1px solid {BORDER};
}}

/* Ghost */
QPushButton[btnVariant="ghost"] {{
    background-color: transparent;
    color: {TEXT_SECONDARY};
    border: 1px solid transparent;
}}
QPushButton[btnVariant="ghost"]:hover {{
    background-color: {SURFACE_LIGHT};
    color: {TEXT_PRIMARY};
    border: 1px solid transparent;
}}
QPushButton[btnVariant="ghost"]:pressed,
QPushButton[btnVariant="ghost"]:checked {{
    background-color: {ACCENT_SUBTLE};
    color: {TEXT_PRIMARY};
    border: 1px solid transparent;
}}
QPushButton[btnVariant="ghost"]:disabled {{
    background-color: transparent;
    color: {TEXT_MUTED};
    border: 1px solid transparent;
}}

/* Danger (outlined destructive look) */
QPushButton[btnVariant="danger"] {{
    background-color: {SURFACE_LIGHT};
    color: {DANGER};
    border: 1px solid {BORDER};
}}
QPushButton[btnVariant="danger"]:hover {{
    background-color: {SURFACE};
    color: {DANGER};
    border: 1px solid {DANGER};
}}
QPushButton[btnVariant="danger"]:pressed,
QPushButton[btnVariant="danger"]:checked {{
    background-color: {ACCENT_SUBTLE};
    color: {DANGER};
    border: 1px solid {DANGER};
}}
QPushButton[btnVariant="danger"]:disabled {{
    background-color: {SURFACE_LIGHT};
    color: {TEXT_MUTED};
    border: 1px solid transparent;
}}

/* Segment (chips inside SegmentedControl) */
QPushButton[btnVariant="segment"] {{
    background-color: transparent;
    color: {TEXT_SECONDARY};
    border: 1px solid transparent;
}}
QPushButton[btnVariant="segment"]:hover,
QPushButton[btnVariant="segment"]:pressed {{
    background-color: {SURFACE_LIGHT};
    color: {TEXT_PRIMARY};
    border: 1px solid transparent;
}}
QPushButton[btnVariant="segment"]:checked {{
    background-color: {SURFACE_CARD};
    color: {TEXT_PRIMARY};
    border: 1px solid {BORDER};
}}
QPushButton[btnVariant="segment"]:disabled {{
    background-color: transparent;
    color: {TEXT_MUTED};
    border: 1px solid transparent;
}}

/* Link */
QPushButton[btnVariant="link"] {{
    background-color: transparent;
    color: {TEXT_SECONDARY};
    border: 1px solid transparent;
}}
QPushButton[btnVariant="link"]:hover,
QPushButton[btnVariant="link"]:pressed,
QPushButton[btnVariant="link"]:checked {{
    background-color: transparent;
    color: {ACCENT};
    border: 1px solid transparent;
}}
QPushButton[btnVariant="link"]:disabled {{
    background-color: transparent;
    color: {TEXT_MUTED};
    border: 1px solid transparent;
}}

/* Danger flag overrides — must follow the variant blocks so equal
   specificity ties resolve to the destructive look. */
QPushButton[btnVariant="primary"][btnDanger="true"] {{
    background-color: {DANGER};
    color: {ON_ACCENT};
    border: 1px solid {DANGER};
}}
QPushButton[btnVariant="primary"][btnDanger="true"]:hover,
QPushButton[btnVariant="primary"][btnDanger="true"]:checked {{
    background-color: {DANGER_HOVER};
    color: {ON_ACCENT};
    border: 1px solid {DANGER_HOVER};
}}
QPushButton[btnVariant="primary"][btnDanger="true"]:pressed {{
    background-color: {DANGER_PRESSED};
    color: {ON_ACCENT};
    border: 1px solid {DANGER_PRESSED};
}}
QPushButton[btnVariant="primary"][btnDanger="true"]:disabled {{
    background-color: {BORDER};
    color: {TEXT_MUTED};
    border: 1px solid transparent;
}}

QPushButton[btnVariant="filled"][btnDanger="true"] {{
    background-color: {SURFACE_LIGHT};
    color: {DANGER};
    border: 1px solid {DANGER};
}}
QPushButton[btnVariant="filled"][btnDanger="true"]:hover {{
    background-color: {SURFACE};
    color: {DANGER};
    border: 1px solid {DANGER};
}}
QPushButton[btnVariant="filled"][btnDanger="true"]:pressed,
QPushButton[btnVariant="filled"][btnDanger="true"]:checked {{
    background-color: {SURFACE_LIGHT};
    color: {DANGER};
    border: 1px solid {DANGER};
}}
QPushButton[btnVariant="filled"][btnDanger="true"]:disabled {{
    background-color: {SURFACE_LIGHT};
    color: {TEXT_MUTED};
    border: 1px solid {BORDER};
}}

QPushButton[btnVariant="tonal"][btnDanger="true"] {{
    background-color: {ACCENT_SUBTLE};
    color: {DANGER};
    border: 1px solid {DANGER};
}}
QPushButton[btnVariant="tonal"][btnDanger="true"]:hover {{
    background-color: {SURFACE};
    color: {DANGER};
    border: 1px solid {DANGER};
}}
QPushButton[btnVariant="tonal"][btnDanger="true"]:pressed,
QPushButton[btnVariant="tonal"][btnDanger="true"]:checked {{
    background-color: {SURFACE_LIGHT};
    color: {DANGER};
    border: 1px solid {DANGER};
}}
QPushButton[btnVariant="tonal"][btnDanger="true"]:disabled {{
    background-color: {SURFACE_LIGHT};
    color: {TEXT_MUTED};
    border: 1px solid transparent;
}}

QPushButton[btnVariant="hollow"][btnDanger="true"],
QPushButton[btnVariant="outlined"][btnDanger="true"],
QPushButton[btnVariant="segment"][btnDanger="true"] {{
    background-color: transparent;
    color: {DANGER};
    border: 1px solid {DANGER};
}}
QPushButton[btnVariant="hollow"][btnDanger="true"]:hover,
QPushButton[btnVariant="outlined"][btnDanger="true"]:hover,
QPushButton[btnVariant="segment"][btnDanger="true"]:hover {{
    background-color: {SURFACE_LIGHT};
    color: {DANGER};
    border: 1px solid {DANGER};
}}
QPushButton[btnVariant="hollow"][btnDanger="true"]:pressed,
QPushButton[btnVariant="hollow"][btnDanger="true"]:checked,
QPushButton[btnVariant="outlined"][btnDanger="true"]:pressed,
QPushButton[btnVariant="outlined"][btnDanger="true"]:checked,
QPushButton[btnVariant="segment"][btnDanger="true"]:pressed,
QPushButton[btnVariant="segment"][btnDanger="true"]:checked {{
    background-color: {ACCENT_SUBTLE};
    color: {DANGER};
    border: 1px solid {DANGER};
}}
QPushButton[btnVariant="hollow"][btnDanger="true"]:disabled {{
    background-color: transparent;
    color: {TEXT_MUTED};
    border: 1px solid {BORDER};
}}
QPushButton[btnVariant="outlined"][btnDanger="true"]:disabled,
QPushButton[btnVariant="segment"][btnDanger="true"]:disabled {{
    background-color: transparent;
    color: {TEXT_MUTED};
    border: 1px solid transparent;
}}

QPushButton[btnVariant="ghost"][btnDanger="true"],
QPushButton[btnVariant="link"][btnDanger="true"] {{
    background-color: transparent;
    color: {DANGER};
    border: 1px solid transparent;
}}
QPushButton[btnVariant="ghost"][btnDanger="true"]:hover,
QPushButton[btnVariant="link"][btnDanger="true"]:hover {{
    background-color: {SURFACE_LIGHT};
    color: {DANGER};
    border: 1px solid transparent;
}}
QPushButton[btnVariant="ghost"][btnDanger="true"]:pressed,
QPushButton[btnVariant="ghost"][btnDanger="true"]:checked,
QPushButton[btnVariant="link"][btnDanger="true"]:pressed,
QPushButton[btnVariant="link"][btnDanger="true"]:checked {{
    background-color: {ACCENT_SUBTLE};
    color: {DANGER};
    border: 1px solid transparent;
}}
QPushButton[btnVariant="ghost"][btnDanger="true"]:disabled,
QPushButton[btnVariant="link"][btnDanger="true"]:disabled {{
    background-color: transparent;
    color: {TEXT_MUTED};
    border: 1px solid transparent;
}}

/* Group Boxes */
QGroupBox {{
    background-color: {SURFACE};
    border: 1px solid {BORDER};
    border-radius: 12px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
    color: {TEXT_PRIMARY};
}}

QGroupBox::title {{
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: {TEXT_PRIMARY};
}}

/* Text Fields & Editors
   Native fallback only: every app field is src/gui/components/input.py, which
   styles itself via Styles.get_input_qss. These rules keep Qt-internal editors
   (spin-box line edits, dialogs) visually identical to the component. */
QLineEdit {{
    background-color: {SURFACE};
    color: {TEXT_PRIMARY};
    border: 1px solid {BORDER};
    border-radius: 8px;
    padding: 0 10px;
    font-size: 13px;
}}

QLineEdit:focus {{
    border: 1px solid {ACCENT};
}}

QTextEdit {{
    background-color: {SURFACE};
    color: {TEXT_PRIMARY};
    border: 1px solid {BORDER};
    border-radius: 8px;
    padding: 12px;
    font-size: 13px;
}}

/* SpinBoxes */
QSpinBox, QDoubleSpinBox {{
    background-color: {SURFACE};
    color: {TEXT_PRIMARY};
    border: 1px solid {BORDER};
    border-radius: 8px;
    padding: 0 10px;
    min-height: 34px;
    font-size: 13px;
}}

/* Sliders */
QSlider::groove:horizontal {{
    height: 6px;
    background: {BORDER};
    border-radius: 3px;
}}

QSlider::sub-page:horizontal {{
    background: {ACCENT};
    border-radius: 3px;
}}

QSlider::handle:horizontal {{
    background: {TEXT_PRIMARY};
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}}

QSlider::handle:horizontal:hover {{
    background: {ACCENT};
}}

/* Combo Boxes */
QComboBox {{
    background-color: {SURFACE_LIGHT};
    color: {TEXT_PRIMARY};
    border: 1px solid {BORDER};
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 500;
}}

QComboBox:hover {{
    border-color: {BORDER_LIGHT};
}}

QComboBox::drop-down {{
    border: none;
    width: 20px;
}}

QComboBox QAbstractItemView {{
    background-color: {SURFACE};
    color: {TEXT_PRIMARY};
    selection-background-color: {ACCENT};
    selection-color: #FFFFFF;
    border: none;
    outline: 0px;
    padding: 4px;
}}

QComboBox QAbstractItemView::item {{
    min-height: 26px;
    padding: 4px 8px;
    border-radius: 4px;
}}

/* Tables */
QTableWidget {{
    background-color: {SURFACE};
    color: {TEXT_PRIMARY};
    border: 1px solid {BORDER};
    border-radius: 8px;
    gridline-color: transparent;
    font-size: 13px;
}}

QTableWidget::item {{
    padding: 4px 6px;
    border: none;
    border-bottom: 1px solid {SURFACE_LIGHT};
}}

QTableWidget::item:hover {{
    background-color: {SURFACE_LIGHT};
    border-radius: 4px;
}}

QTableWidget::item:selected {{
    background-color: {HIGHLIGHT};
    color: {TEXT_PRIMARY};
    border-radius: 4px;
}}

QHeaderView::section {{
    background-color: {SURFACE_LIGHT};
    color: {TEXT_PRIMARY};
    padding: 8px 6px;
    border: none;
    border-bottom: 2px solid {ACCENT};
    font-weight: 700;
    font-size: 13px;
}}

/* Tab Widget */
QTabWidget {{
    background-color: {BACKGROUND};
}}

QTabWidget::pane {{
    border: none;
    background-color: transparent;
}}

/* Tabs are styled by src/gui/components/tabs.py (Styles.get_tabs_style);
   a global QTabBar rule here would leak into that component. */

/* Checkboxes */
QCheckBox {{
    color: {TEXT_PRIMARY};
    font-weight: 600;
    font-size: 12px;
    background-color: {SURFACE};
    border: 1px solid {BORDER};
    border-radius: 8px;
    padding: 6px 12px;
    spacing: 8px;
}}

QCheckBox:hover {{
    background-color: {SURFACE_LIGHT};
    border-color: {BORDER_LIGHT};
}}

QCheckBox::indicator {{
    width: 16px;
    height: 16px;
    border: 1px solid {BORDER};
    border-radius: 4px;
    background-color: {SURFACE_LIGHT};
}}

QCheckBox::indicator:hover {{
    border-color: {ACCENT};
}}

QCheckBox::indicator:checked {{
    background-color: {ACCENT};
    border-color: {ACCENT};
    image: url('{TICK_PATH}');
}}

/* Scrollbars */
QScrollBar:vertical {{
    background: {BACKGROUND};
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}}

QScrollBar::handle:vertical {{
    background: {BORDER};
    min-height: 20px;
    border-radius: 4px;
}}

QScrollBar::handle:vertical:hover {{
    background: {BORDER_LIGHT};
}}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{
    height: 0px;
    background: none;
}}

/* ═══════════════════════════════════════════════════════════════════
   PHASE 1 — Global chrome migrations
   These rules centralize styles that were previously rebuilt at
   runtime in dozens of widgets. They are safe to add before the
   widgets are migrated because unmatched selectors are simply ignored.
   ═══════════════════════════════════════════════════════════════════ */

/* Status Bar */
QStatusBar {{
    background-color: {BACKGROUND};
    border-top: 1px solid {BORDER};
}}
QStatusBar QLabel {{
    background: transparent;
}}

/* Splitters */
QSplitter {{
    background-color: {BACKGROUND};
}}
QSplitter::handle {{
    background-color: {BORDER};
}}

/* Menus */
QMenu {{
    background-color: {SURFACE_CARD};
    color: {TEXT_PRIMARY};
    border: 1px solid {BORDER};
    border-radius: 8px;
    padding: 6px;
}}
QMenu::item {{
    padding: 7px 14px;
    border-radius: 6px;
}}
QMenu::item:selected {{
    background-color: {SURFACE_LIGHT};
}}
QMenu::item:disabled {{
    color: {TEXT_MUTED};
}}

/* Header Bars */
QFrame#AnalysisHeaderBar,
QFrame#HistoryHeaderBar,
QFrame#MetricsHeaderBar,
QFrame#SettingsHeaderBar,
QFrame#ExplorerHeaderBar,
QFrame#ImportHeader,
QFrame#DrillDownHeaderBar {{
    background-color: {BACKGROUND};
    border-bottom: 1px solid {BORDER};
}}
QFrame#AnalysisHeaderBar QLabel,
QFrame#HistoryHeaderBar QLabel,
QFrame#MetricsHeaderBar QLabel,
QFrame#SettingsHeaderBar QLabel,
QFrame#ExplorerHeaderBar QLabel,
QFrame#ImportHeader QLabel,
QFrame#DrillDownHeaderBar QLabel {{
    background: transparent;
    border: none;
}}

QFrame#filter_bar {{
    background-color: {BACKGROUND};
    border-bottom: 1px solid {BORDER};
}}

/* Sidebar */
QFrame#Sidebar {{
    background-color: {SURFACE};
    border-right: 1px solid {BORDER};
}}

/* Welcome / Empty State */
QFrame#WelcomePanel,
QFrame#WelcomeCard {{
    background-color: {BACKGROUND};
    border: none;
}}
QFrame#WelcomePanel QFrame#divider {{
    background-color: {BORDER};
    max-height: 1px;
    border: none;
}}
QFrame#EmptyStateCTA {{
    background-color: transparent;
    border: none;
    border-radius: 8px;
}}
QFrame#EmptyStateCTA[dropHighlight="true"] {{
    border: 1px solid {ACCENT};
}}

/* Settings Cards */
QGroupBox[settingsCard="true"] {{
    background: transparent;
    border: none;
    margin-top: 18px;
    padding: 6px 0 0 0;
}}
QGroupBox[settingsCard="true"]::title {{
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0px;
    padding: 0 0 6px 0;
}}

QFrame#SettingsDivider,
QFrame#ReportDivider,
QFrame#HangingDivider {{
    background-color: {BORDER};
    max-height: 1px;
    border: none;
}}

/* Metric card child transparency (already partially covered; explicit
   for any widget added after the card is constructed). */
QFrame#MetricCard > QWidget,
QFrame[metric_card="true"] > QWidget {{
    background-color: transparent;
}}

/* Metric card internal frames */
QFrame#opening_item,
QFrame#brilliancy_row,
QFrame#HangingPieceRow,
QFrame#format_row,
QFrame#TacticsRow {{
    background-color: {SURFACE_LIGHT};
    border: 1px solid {BORDER};
    border-radius: 8px;
}}
QFrame#opening_item:hover,
QFrame#brilliancy_row:hover,
QFrame#HangingPieceRow:hover,
QFrame#format_row:hover,
QFrame#TacticsRow:hover {{
    border-color: {ACCENT};
}}

QFrame#phase_pillar,
QFrame#adv_pillar,
QFrame#comeback_pillar,
QFrame#conversion_insight_frame,
QFrame#leak_pillar,
QFrame#vigilance_pillar,
QFrame#AccuracyBadge,
QFrame#MomentumBadge,
QFrame#TacticsTopPill,
QFrame#to_pill,
QFrame#dq_card,
QFrame#CoachErrorFrame,
QFrame#DrillDownCard,
QFrame#ProfilePreview {{
    background-color: {SURFACE_LIGHT};
    border: 1px solid {BORDER};
    border-radius: 8px;
}}

QFrame#PhaseIconTile,
QFrame#IconTile,
QFrame#StatPanel,
QFrame#NoClockBanner,
QFrame#TimeTroubleBanner {{
    background-color: {SURFACE};
    border: 1px solid {BORDER};
    border-radius: 8px;
}}

/* Import Workspace */
QFrame#ImportActionBar {{
    background-color: {SURFACE};
    border-top: 1px solid {BORDER};
}}
QTableView#ImportTable {{
    background-color: {SURFACE};
    color: {TEXT_PRIMARY};
    border: 1px solid {BORDER};
    border-radius: 8px;
    gridline-color: transparent;
}}
QTableView#ImportTable::item {{
    padding: 6px;
    border-bottom: 1px solid {SURFACE_LIGHT};
}}
QTableView#ImportTable::item:selected {{
    background-color: {HIGHLIGHT};
}}

/* History / Batch */
QFrame#HistoryFilterPanel {{
    background-color: {SURFACE};
    border: 1px solid {BORDER};
    border-radius: 8px;
}}
QFrame#BatchSelectionBar {{
    background-color: {SURFACE};
    border-bottom: 1px solid {BORDER};
}}
QFrame#BatchQueueCard,
QFrame#BatchCurrentGame {{
    background-color: {SURFACE};
    border: 1px solid {BORDER};
    border-radius: 8px;
}}
QListWidget#BatchUpNextList {{
    background-color: transparent;
    border: none;
}}
QFrame#BatchStatTile {{
    background-color: {SURFACE_LIGHT};
    border: 1px solid {BORDER};
    border-radius: 8px;
}}

/* Explorer */
QScrollArea#BookScroll {{
    background-color: {SURFACE};
    border: 1px solid {BORDER};
    border-radius: 8px;
}}
QWidget#BookRow {{
    background-color: transparent;
    border-bottom: 1px solid {SURFACE_LIGHT};
}}
QWidget#BookRow:hover {{
    background-color: {SURFACE_LIGHT};
}}

QFrame#explorerBookSkeletonRow {{
    background-color: transparent;
    border-bottom: 1px solid {BORDER};
}}
QFrame#explorerBookSkeletonIcon {{
    background-color: {SURFACE_LIGHT};
    border-radius: 4px;
}}
QFrame#explorerBookSkeletonBar {{
    background-color: {SURFACE_LIGHT};
    border-radius: 4px;
}}
QFrame#explorerBookSkeletonRatio {{
    background-color: {SURFACE_LIGHT};
    border-radius: 4px;
}}

/* Analysis chrome */
QWidget#BoardControls {{
    background: transparent;
    border: none;
    border-top: 1px solid {BORDER};
}}
QFrame#BoardGameHeader {{
    background: transparent;
    border: none;
    border-bottom: 1px solid {BORDER};
}}
QFrame#VariationGraph {{
    background-color: {SURFACE_LIGHT};
    border: 1px solid {BORDER};
    border-radius: 8px;
}}
QFrame#CoachCard {{
    background-color: {SURFACE};
    border: 1px solid {BORDER};
    border-radius: 12px;
}}

/* Move List */
QFrame#MoveListCard {{
    background-color: {SURFACE};
    border: 1px solid {BORDER};
    border-radius: 8px;
}}
QTableWidget#MoveListTable {{
    background-color: {SURFACE};
    color: {TEXT_PRIMARY};
    border: 1px solid {BORDER};
    border-radius: 8px;
    gridline-color: transparent;
}}
QWidget#MoveCellWidget[state="selected"] {{
    background-color: {ACCENT_SUBTLE};
    border-left: 3px solid {ACCENT};
}}
QWidget#MoveCellWidget[state="hovered"] {{
    background-color: {SURFACE_LIGHT};
}}
QWidget#MoveCellWidget[state="active"] {{
    background-color: {SURFACE};
}}
QWidget#MoveCellWidget[state="normal"] {{
    background-color: transparent;
}}

/* Components */
QFrame#StatCard,
QFrame#SimpleStatCard {{
    background-color: {SURFACE};
    border: 1px solid {BORDER};
    border-radius: 12px;
}}
QFrame#StatCard:hover,
QFrame#SimpleStatCard:hover {{
    border-color: {ACCENT};
    background-color: {SURFACE_LIGHT};
}}
QFrame#StatCard QLabel,
QFrame#SimpleStatCard QLabel {{
    background: transparent;
    border: none;
}}

QFrame#PaginationBar {{
    background-color: {SURFACE};
    border-top: 1px solid {BORDER};
}}

QFrame#FilterChip {{
    background-color: {SURFACE_LIGHT};
    border: 1px solid {BORDER};
    border-radius: 16px;
}}

QProgressBar,
QProgressBar[variant="thin"] {{
    background-color: {SURFACE_LIGHT};
    border: 1px solid {BORDER};
    border-radius: 4px;
}}
QProgressBar::chunk {{
    background-color: {ACCENT};
    border-radius: 4px;
}}

QScrollArea[transparentScroll="true"] {{
    background: transparent;
    border: none;
}}

QLabel#Avatar {{
    background-color: {ACCENT_SUBTLE};
    color: {ACCENT};
    border: 1px solid {BORDER};
    border-radius: 50%;
}}

QFrame#GameCard[selected="true"] {{
    background-color: {ACCENT_SUBTLE};
    border: 1px solid {ACCENT};
}}
QFrame#GameCard[selected="false"] {{
    background-color: {SURFACE_CARD};
    border: 1px solid {BORDER};
}}
QFrame#GameCard[selected="false"]:hover {{
    border-color: {ACCENT};
    background-color: {SURFACE};
}}

/* Historic Bar */
QFrame#HistoricInfoBar {{
    background-color: {SURFACE};
    border: none;
    border-top: 1px solid {BORDER};
    border-radius: 0px;
}}
QFrame#HistoricInfoBar QLabel {{
    background: transparent;
    border: none;
}}
QFrame#HistoricCelebration {{
    background-color: {SURFACE_LIGHT};
    border: 1px solid {BORDER};
    border-radius: 6px;
}}
QFrame#HistoricCelebration QLabel {{
    background: transparent;
    border: none;
}}
QFrame#HistoricCelebration[solved="true"] {{
    border: 1px solid {ACCENT};
}}

